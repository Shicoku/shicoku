---
import { Image } from "astro:assets";

import { projects } from "../../data/projects";
---

<div class="projects-grid">
  {projects.slice(0, 4).map((project) => (
    <div>
      <a href={`/projects/${project.slug}`}>
        <Image src={project.image} alt={project.title} width={400} />
      </a>
    </div>
  ))}
</div>
<div class="projects-footer">
  <a href="/projects" class="view-more-btn">View More</a>
</div>

<style>
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
    justify-items: center;
    max-width: 900px;
    margin: 0 auto;
    border: solid 5px #fff;
    border-radius: 15px;
    padding: 3rem 5.5rem;
    position: relative;
    margin-top: 80px;
  }

  .projects-grid::before {
    content: "Projects";
    position: absolute;
    top: -60px;
    left: 7%;
    font-size: 3rem;
    font-weight: 700;
    background: #7ea3cc;
    padding: 0 20px;
    color: #fff;
    font-family: boldnese;
  }

  .projects-grid div {
    padding: 20px;
  }

  .projects-footer {
    display: flex;
    justify-content: center;
    margin-top: 2rem;
  }

  .view-more-btn {
    display: inline-block;
    text-decoration: none;
    font-size: 2rem;
    font-family: boldnese;
    color: #fff;
    cursor: pointer;
    transition: all 0.2s ease;
    position: relative;
  }

  .view-more-btn:hover {
    color: #5a7d9f;
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-underline-offset: 6px;
    transform: scale(1.02);
  }

  .view-more-btn:active {
    transform: scale(0.98);
  }

  @media screen and (max-width: 789px) {
    .projects-grid {
      grid-template-columns: 1fr;
      padding: 3.5rem 0;
    }

    .projects-grid div {
      padding: 20px 0;
    }

    .projects-grid img {
      width: 300px;
      height: auto;
    }
  }
</style>
