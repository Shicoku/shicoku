---
import { Image } from "astro:assets";

import Layout from "../layouts/Layout.astro";

import { projects } from "../data/projects";
import { gallery } from "../data/gallery";
---

<Layout>
  <main>
    <div class="projects-grid">
      {
        projects.map((p) => (
          <div>
            <a href={`/projects/${p.slug}`}>
              <Image src={p.image} alt={p.title} width={500} />
            </a>
          </div>
        ))
      }
    </div>
    <!-- <div class="projects-grid">
      {
        gallery.map((g) => (
          <div>
            <Image src={g.image} alt={g.title} width={500} />
          </div>
        ))
      }
    </div> -->
  </main>
</Layout>

<style>
  main {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
    max-width: 900px;
    border-radius: 15px;
    padding: 3rem 5.5rem;
    position: relative;
    margin-top: 150px;
  }

  .projects-grid::before {
    content: "";
    position: absolute;
    top: -60px;
    left: 7%;
    font-size: 3rem;
    font-weight: 700;
    color: #fff;
    font-family: boldnese;
  }
  .projects-grid:nth-of-type(1)::before {
    content: "Works";
  }
  .projects-grid:nth-of-type(2)::before {
    content: "Gallery";
  }

  .projects-grid div {
    padding-right: 20px;
    padding-bottom: 20px;
  }

  @media screen and (max-width: 789px) {
    .projects-grid {
      grid-template-columns: 1fr;
      padding: 3.5rem 0;
    }

    .projects-grid div {
      padding: 20px 0;
    }

    .projects-grid img {
      width: 300px;
      height: auto;
    }
  }
</style>
